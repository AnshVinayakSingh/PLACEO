# ── DATABASE ──────────────────────────────────────────────
# Get this from MongoDB Atlas → Connect → "Connect your application"
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/
MONGODB_URI=

# ── AUTH ──────────────────────────────────────────────────
# Any long random string, used to sign login sessions.
# Generate one at: https://generate-secret.vercel.app/32
JWT_SECRET=

# ── AI (chatbot / mentor) ──────────────────────────────────
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── GOOGLE SIGN-IN ────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth Client ID.
# Both variables use the SAME value (the Client ID). No client secret needed.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
